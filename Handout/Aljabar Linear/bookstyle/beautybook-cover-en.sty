\usepackage{adjustbox} %修正minipage顶部对齐问题
\tikzfading[name=fade right,
    right color =transparent!100,
    left color=transparent!50]
\tikzfading[name=fade left,
    left color =transparent!100,
    right color=transparent!50]
\tikzfading[name=fade up,
    top color =transparent!100, % 完全透明
    bottom color=transparent!50] % 半透明
\tikzfading[name=fade down,
    bottom color =transparent!100,
    top color=transparent!50]
% Radial alpha mask: light at the centre, fully transparent at the edge.
\pgfdeclareradialshading{beautybook-logo-glow-mask}{\pgfpointorigin}{%
    color(0bp)=(pgftransparent!0);
    color(8bp)=(pgftransparent!10);
    color(14bp)=(pgftransparent!40);
    color(20bp)=(pgftransparent!85);
    color(25bp)=(pgftransparent!100);
    color(50bp)=(pgftransparent!100)}
\pgfdeclarefading{beautybook-logo-glow}{\pgfuseshading{beautybook-logo-glow-mask}}
\makeatletter
% LogoAA.png includes a 1:4 clear margin around the visible mark.
% At 24 mm image width, the visible mark is about 16 mm wide and 15.7 mm
% high (above the guideline's 10 mm minimum). Keep the full image bounds.
\newcommand{\beautybookpublishermark}{%
    \begin{minipage}[c]{2.4cm}
        \includegraphics[width=\linewidth]{\@presslogo}%
    \end{minipage}%
    \hspace{1mm}%
    {\color{coverbar!70!white}\rule[-.4cm]{.6pt}{.8cm}}%
    \hspace{3mm}%
    \begin{varwidth}[c]{.35\textwidth}
        \sffamily\bfseries\large\@pressname
    \end{varwidth}%
}
\newcommand{\beautybookpublisher}{%
    % Keep the image above the glow, using the same page coordinate system.
    \begin{pgfonlayer}{foreground}
        \node[anchor=south east,text=white,inner sep=0pt]
        (beautybook-publisher) at ([shift={(-2cm,2cm)}]current page.south east)
            {\beautybookpublishermark};
    \end{pgfonlayer}
    \fill[white,opacity=.45,path fading=beautybook-logo-glow]
    ([xshift=1.2cm]beautybook-publisher.west) circle[radius=1.5cm];
}
% Shared by A4 and Letter. Call after the background gradients, before text.
\newcommand{\beautybookcoverornaments}{%
    \coordinate (start) at ($(current page.east)!0.5!(current page.north east)+(1,-1)$);
    \coordinate (end)   at (current page.north west);
    \foreach \i in {0,0.01,...,1}
        {
            \coordinate (point) at ($(start)!\i!(end)$);
            \draw[coverbar!35!white,opacity=.10,line width=.3pt]
            ($(point)+(310*\i:6)$)--
            ($(point)+(310*\i+120:6)$)--
            ($(point)+(310*\i+240:6)$)--
            ($(point)+(310*\i:6)$);
        }
    \coordinate (start) at (current page.south west);
    \coordinate (end)   at (current page.east);
    \foreach \i in {0,0.02,...,1}
        {
            \coordinate (point) at ($(start)!\i!(end)$);
            \draw[coverbar!35!white,opacity=.10,line width=.3pt]
            ($(point)+(310*\i:10)$)--
            ($(point)+(310*\i+120:10)$)--
            ($(point)+(310*\i+240:10)$)--
            ($(point)+(310*\i:10)$);
        }
}
\newcommand{\aivcover}{
    \begin{tikzpicture}[remember picture,overlay]
        \fill[coverfgcolor]
        (current page.north west) rectangle (current page.south east);
        \shade[bottom color=coverfgcolor,top color=coverfgcolor!75!coverbar,opacity=0.7]
        ([xshift=.5\outermarginwidth]current page.north west) rectangle (current page.south east); % 背景大矩形
        \shade[left color=coverfgcolor!82!black,right color=coverfgcolor,opacity=0.5]
        ([xshift=\outermarginwidth,yshift=2\outermarginwidth]current page.west) rectangle (current page.south east); % 标题背景大矩形
        \foreach \lx/\rx/\ry/\bc/\tc in {
                1/1.5/1.75/70/80,1.5/2/1.6/65/75,2/2.5/1.3/60/70,2.5/3/1/55/65,3/3.5/.7/50/60,3.5/4/1.2/60/70,4/4.5/1.9/75/85,4.5/5/1.1/55/65,5/5.5/1.2/60/70,6/6.5/1.6/65/75,6.5/7/1.3/60/70,7/7.5/1.87/70/80,7.5/8/1/55/65,8/8.5/.9/50/60,8.5/9/1.8/70/80,9/9.5/1.6/65/75,9.5/10/1.4/60/70,10/10.5/1/55/65,10.5/11/.7/50/60,11/11.5/1.3/55/65,11.5/12/1/70/80,12/12.5/1.3/65/75,12.5/13/1.6/60/70,13/13.5/1.75/55/65,13.5/14/1.6/65/75,14/14.5/1.3/60/70
            }{
                \shade[bottom color=coverfgcolor!\bc!coverbar,top color=coverfgcolor!\tc!coverbar,opacity=.3]
                ([xshift=\lx\outermarginwidth]current page.north west) rectangle ([xshift=\rx\outermarginwidth,yshift=-\ry\covershift]current page.north west);%顶部琴键矩形
            }
        \beautybookcoverornaments
        \fill[coverbar]
        ([yshift=2\outermarginwidth]current page.west) rectangle ([xshift=\outermarginwidth,yshift=-.2\outermarginwidth]current page.west);
        \node[anchor=south] at ([xshift=.3\outermarginwidth,yshift=-.4\covershift]current page.north) {%
            \parbox{.8\paperwidth}{
                \filright
                \color{white}\sffamily\fontsize{20}{23}\selectfont\@bookseries}
        }; %系列丛书名称
        \node[ anchor=south,below right] (covertitles) at ([xshift=1.8\outermarginwidth-0.2cm,yshift=2.7cm]current page.west)
        {\parbox{.8\paperwidth}{%
                \raggedright%
                {\renewcommand\baselinestretch{1.1}\selectfont           \color{white}\sffamily\bfseries\fontsize{40}{40}\selectfont\@title\\[0.5ex]
                    \color{coverbar}\sffamily\fontsize{30}{30}\selectfont
                    \ifdefvoid{\@subtitle}{}{\@subtitle}\par}
            }};% 封面标题与副标题
        \node[anchor=west,font=\sc\fontsize{23}{23}\selectfont,text=white] at ([shift={(-.4\paperwidth,-6cm)}]covertitles) {\@edition};
        \node[anchor=west,font=\sffamily\Huge,text=white] at ([xshift=1.8\outermarginwidth-0.3cm,yshift=\covershift]current page.west) {\@author};
        \beautybookpublisher
    \end{tikzpicture}%
    {\newpage\thispagestyle{empty}}
}

